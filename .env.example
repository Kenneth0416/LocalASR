# Meeting Realtime Voice - Environment Configuration

# LLM provider: local llama.cpp server by default.
LLAMACPP_BASE_URL=http://localhost:8190
LLAMACPP_MODEL=qwen3.5:9b

# OpenAI-compatible API (leave empty to stay on llama.cpp).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ASR runtime (MLX-only).
ASR_MODEL_PATH=~/whisper-models/Qwen3-ASR-1.7B
ASR_LANGUAGE=
ASR_BACKEND=mlx
ASR_INIT_TIMEOUT_SEC=240
ASR_MAX_NEW_TOKENS=256

# MLX ASR tuning.
ASR_MLX_MODEL_PATH=
ASR_MLX_MAX_NEW_TOKENS=2048
ASR_MLX_TEMPERATURE=0.0
ASR_MLX_REPETITION_PENALTY=1.3
ASR_MLX_REPETITION_CONTEXT_SIZE=50

# Semantic chunking.
ASR_MIN_CHUNK_SEC=4.0
ASR_PREFERRED_CHUNK_SEC=8.0
ASR_MAX_CHUNK_SEC=12.0
ASR_OVERLAP_SEC=1.5
ASR_ENDPOINT_SILENCE_SEC=0.45
ASR_BOUNDARY_SEARCH_SEC=1.25
ASR_SEMANTIC_PAUSE_SEC=0.45
ASR_SEMANTIC_SOFT_PAUSE_SEC=0.6
ASR_SEMANTIC_FORCE_COMMIT_SEC=18.0

# WebRTC VAD realtime tuning.
WEBRTC_VAD_FRAME_MS=20
WEBRTC_VAD_AGGRESSIVENESS=2
WEBRTC_VAD_ENTER_SPEECH_FRAMES=2
WEBRTC_VAD_ENDPOINT_SILENCE_FRAMES=36
WEBRTC_VAD_MAX_UTTERANCE_SEC=18.0
WEBRTC_VAD_PRE_ROLL_SEC=0.2
WEBRTC_VAD_MIN_FINAL_AUDIO_SEC=0.1

# Server.
HOST=127.0.0.1
PORT=8800
CORS_ORIGINS=http://127.0.0.1:8800,http://localhost:8800
CORS_ALLOW_CREDENTIALS=false
EXPOSE_SESSION_API=false
AUDIO_QUEUE_MAXSIZE=32
MEETING_RECORDINGS_DIR=recordings
MEETING_DB_PATH=data/meeting_realtime_voice.sqlite3
MEETING_HISTORY_LIMIT=100

# Meeting behavior.
MAX_CONTEXT_MESSAGES=50
MAX_CONTEXT_CHARS=50000
SUMMARY_INTERVAL_TURNS=30
